create table movies(
	movie_id varchar(20) not null,
	title varchar(100) not null,
	content text,
	rating varchar(20),
	release_year int,
	company varchar(100),
	director varchar(50),
	genre varchar(100),
	actors varchar(200),
	primary key (movie_id)
);
