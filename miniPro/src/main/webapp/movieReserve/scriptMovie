select m.movie_id, title, content, rating, release_year, company, director, genre, actors, schedule_id, s.screen_id, start_time, price, screen_name, seat, img_src
from movies as m left join schedule as s on m.movie_id = s.movie_id left join screen sc on s.screen_id = sc.screen_id;

create table reservation (
	reservation_id int auto_increment,
	schedule_id int not null,
	user_id varchar(50) not null,
	seat_num varchar(20) not null,
	reservation_time timestamp default current_timestamp,
	primary key (reservation_id),
	foreign key (schedule_id) references schedule(schedule_id) on delete cascade
);
select * from reservation;
TRUNCATE TABLE reservation;
alter table reservation modify seat_num varchar(200) not null;

SELECT r.reservation_id, r.user_id, r.seat_num, r.reservation_time, m.title, s.start_time, sc.screen_name
					FROM reservation r JOIN schedule s ON r.schedule_id = s.schedule_id JOIN movies m ON s.movie_id = m.movie_id LEFT JOIN screen sc ON s.screen_id = sc.screen_id
					ORDER BY r.reservation_id DESC